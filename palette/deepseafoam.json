{
  "$schema": "./schema.json",
  "name": "DeepSeaFoam",
  "version": "0.4.1",
  "description": "A quiet workstation beneath deep water, with small seafoam-colored signals and warm light illuminating what matters.",
  "attribution": {
    "origin": "SpriteCanvas",
    "originUrl": "https://github.com/Zanark/SpriteCanvas",
    "derivedFrom": "Solarized",
    "derivedFromUrl": "https://ethanschoonover.com/solarized/",
    "terminalInspiration": "Solarized Dark Higher Contrast (user-supplied scheme)"
  },
  "pastelAdaptation": {
    "sourceVersion": "0.3.0",
    "space": "oklch",
    "lightness": 0.73,
    "chroma": 0.12,
    "originals": {
      "accent": "#2AA198",
      "document": "#859900",
      "warning": "#B58900",
      "error": "#DC322F"
    }
  },
  "solid": {
    "base": { "value": "#000F13", "role": "Near-black teal workspace and recessed surface" },
    "panel": { "value": "#001E26", "role": "Headers, toolbars, and surrounding panels" },
    "accent": { "value": "#28C0B5", "role": "Vivid pastel seafoam interaction, focus, and active outline" },
    "text": { "value": "#93A1A1", "role": "Primary text and primary-action hover" },
    "faintText": { "value": "#839496", "role": "Genuinely lower-emphasis labels and markers" },
    "warm": { "value": "#EEE8D5", "role": "Warm emphasis, headings, and notices" },
    "lightEdge": { "value": "#FDF6E3", "role": "Precise light selection edge" },
    "border": { "value": "#586E75", "role": "Strong structural border" },
    "document": { "value": "#A0B256", "role": "Vivid pastel kelp document indicator" },
    "warning": { "value": "#C9A244", "role": "Vivid pastel amber warning indicator" },
    "error": { "value": "#E9897E", "role": "Vivid pastel coral error boundary and indicator" }
  },
  "overlay": {
    "separator": { "value": "#586E7566", "role": "Quiet structural separation" },
    "hover": { "value": "#586E7533", "role": "Subtle interaction acknowledgement" },
    "shadowSoft": { "value": "#00000066", "role": "Soft shadow" },
    "shadowStrong": { "value": "#000000CC", "role": "Strong shadow" },
    "backdrop": { "value": "#000000B8", "role": "Modal backdrop" },
    "grid": { "value": "#002B3630", "role": "Faint pixel grid" },
    "guide": { "value": "#28C0B588", "role": "Symmetry guide" },
    "cursor": { "value": "#FDF6E3AA", "role": "Brush cursor" }
  },
  "preview": {
    "checkerLight": { "value": "#D0D1C9", "role": "Main checkerboard light square" },
    "checkerDark": { "value": "#B2B5AE", "role": "Main checkerboard dark square" },
    "navigatorDark": { "value": "#292E33", "role": "Navigator preview shade one" },
    "navigatorLight": { "value": "#30363B", "role": "Navigator preview shade two" },
    "comparisonDark": { "value": "#30373A", "role": "Comparison preview shade one" },
    "comparisonLight": { "value": "#394143", "role": "Comparison preview shade two" },
    "frame": { "value": "#343B40", "role": "Frame-thumbnail background" },
    "layer": { "value": "#191D22", "role": "Layer-thumbnail background" }
  },
  "heritage": {
    "base03": { "value": "#002B36", "status": "inactive", "use": "RGB source for the grid overlay only" },
    "base02": { "value": "#073642", "status": "inactive", "use": "Retained Solarized declaration" },
    "base00": { "value": "#657B83", "status": "inactive", "use": "Retained Solarized declaration" },
    "orange": { "value": "#CB4B16", "status": "extension", "use": "Syntax role not defined by the original UI" },
    "magenta": { "value": "#D33682", "status": "extension", "use": "Syntax role not defined by the original UI" },
    "violet": { "value": "#6C71C4", "status": "extension", "use": "Syntax role not defined by the original UI" },
    "blue": { "value": "#268BD2", "status": "extension", "use": "Syntax role not defined by the original UI" }
  },
  "terminal": {
    "foreground": { "value": "#9CC2C3", "role": "Terminal foreground" },
    "cursorColor": { "value": "#F34B00", "role": "Terminal cursor" },
    "selectionBackground": { "value": "#003748", "role": "Terminal selection" },
    "black": { "value": "#002831", "role": "ANSI black" },
    "red": { "value": "#F54F65", "role": "ANSI red" },
    "green": { "value": "#6CBE6C", "role": "ANSI green" },
    "yellow": { "value": "#EDAE29", "role": "ANSI yellow" },
    "blue": { "value": "#2176C7", "role": "ANSI blue" },
    "purple": { "value": "#C61C6F", "role": "ANSI magenta" },
    "cyan": { "value": "#259286", "role": "ANSI cyan" },
    "white": { "value": "#EAE3CB", "role": "ANSI white" },
    "brightBlack": { "value": "#006488", "role": "ANSI bright black" },
    "brightRed": { "value": "#F5858C", "role": "ANSI bright red" },
    "brightGreen": { "value": "#51EF84", "role": "ANSI bright green" },
    "brightYellow": { "value": "#FFF96E", "role": "ANSI bright yellow" },
    "brightBlue": { "value": "#178EC8", "role": "ANSI bright blue" },
    "brightPurple": { "value": "#E24D8E", "role": "ANSI bright magenta" },
    "brightCyan": { "value": "#00B39E", "role": "ANSI bright cyan" },
    "brightWhite": { "value": "#FCF4DC", "role": "ANSI bright white" }
  },
  "derived": {
    "textSelection": {
      "value": "#28C0B526",
      "source": "#28C0B5",
      "alpha": 0.149,
      "background": "transparent-capable targets",
      "use": "Readable pastel text selection, distinct from the original pixel-selection edge"
    },
    "errorBackground": {
      "value": "#E9897E26",
      "source": "#E9897E",
      "alpha": 0.149,
      "background": "base or panel",
      "use": "Obsidian error surface with readable warm text"
    },
    "errorBackgroundHover": {
      "value": "#E9897E2E",
      "source": "#E9897E",
      "alpha": 0.18,
      "background": "base or panel",
      "use": "Obsidian error surface hover without an opaque pastel wash"
    }
  }
}
