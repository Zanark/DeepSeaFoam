{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepSeaFoam palette",
  "type": "object",
  "required": ["name", "version", "solid", "overlay", "preview", "heritage", "terminal", "derived", "signalAdaptation"],
  "properties": {
    "name": { "const": "DeepSeaFoam" },
    "version": { "type": "string" },
    "solid": { "$ref": "#/$defs/colorMap" },
    "overlay": { "$ref": "#/$defs/colorMap" },
    "preview": { "$ref": "#/$defs/colorMap" },
    "heritage": { "$ref": "#/$defs/colorMap" },
    "terminal": { "$ref": "#/$defs/colorMap" },
    "derived": { "$ref": "#/$defs/colorMap" },
    "signalAdaptation": {
      "type": "object",
      "required": ["space", "method", "sourceGroup", "roles"],
      "properties": {
        "space": { "const": "oklch" },
        "method": { "const": "proportional-shade" },
        "sourceGroup": { "const": "terminal" },
        "roles": {
          "type": "object",
          "required": ["accent", "document", "warning", "error"],
          "propertyNames": { "enum": ["accent", "document", "warning", "error"] },
          "additionalProperties": {
            "type": "object",
            "required": ["source", "scale"],
            "additionalProperties": false,
            "properties": {
              "source": { "type": "string" },
              "scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "colorMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
          }
        }
      }
    }
  }
}
