{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepSeaFoam palette",
  "type": "object",
  "required": ["name", "version", "solid", "overlay", "preview", "heritage", "terminal", "derived", "pastelAdaptation"],
  "properties": {
    "name": { "const": "DeepSeaFoam" },
    "version": { "type": "string" },
    "solid": { "$ref": "#/$defs/colorMap" },
    "overlay": { "$ref": "#/$defs/colorMap" },
    "preview": { "$ref": "#/$defs/colorMap" },
    "heritage": { "$ref": "#/$defs/colorMap" },
    "terminal": { "$ref": "#/$defs/colorMap" },
    "derived": { "$ref": "#/$defs/colorMap" },
    "pastelAdaptation": {
      "type": "object",
      "required": ["sourceVersion", "space", "lightness", "chroma", "originals"],
      "properties": {
        "sourceVersion": { "type": "string" },
        "space": { "const": "oklch" },
        "lightness": { "type": "number", "minimum": 0, "maximum": 1 },
        "chroma": { "type": "number", "minimum": 0 },
        "originals": {
          "type": "object",
          "required": ["accent", "document", "warning", "error"],
          "propertyNames": { "enum": ["accent", "document", "warning", "error"] },
          "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      }
    }
  },
  "$defs": {
    "colorMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
          }
        }
      }
    }
  }
}
