  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#586E75",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#28C0B5"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#C9A244"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#A0B256"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#EEE8D5"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#268BD2"
      }
    },
    {
      "name": "Variables and identifiers",
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#93A1A1"
      }
    },
    {
      "name": "Language variables and special constants",
      "scope": [
        "variable.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D33682"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#268BD2"
      }
    },
    {
      "name": "Attributes and properties",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#6C71C4"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#000F13",
        "background": "#E9897E"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#EEE8D5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#28C0B5",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A0B256"
      }
    },
    {
      "name": "Diff removed",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E9897E"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#586E75",
      "italic": true
    },
    "string": "#28C0B5",
    "number": "#C9A244",
    "keyword": "#A0B256",
    "function": "#EEE8D5",
    "method": "#EEE8D5",
    "type": "#268BD2",
    "class": "#268BD2",
    "interface": "#268BD2",
    "enum": "#268BD2",
    "property": "#6C71C4",
    "variable": "#93A1A1",
    "parameter": "#93A1A1",
    "enumMember": "#D33682",
    "regexp": "#CB4B16",
    "decorator": "#6C71C4"
  }
}
